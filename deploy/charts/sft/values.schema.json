{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "secure-file-transfer chart values",
  "type": "object",
  "required": ["environment", "region", "part", "pilotLight", "cluster", "image", "network"],
  "properties": {
    "environment": { "enum": ["dev", "staging", "prod"] },
    "region": { "enum": ["ap-northeast-1", "ap-northeast-3"] },
    "part": { "enum": ["application", "operator"] },
    "pilotLight": { "type": "boolean" },
    "auditArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["survivingRegionOnly"],
      "properties": {
        "survivingRegionOnly": { "type": "string", "enum": ["", "ap-northeast-1", "ap-northeast-3"] }
      }
    },
    "failover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holdWorkers"],
      "properties": { "holdWorkers": { "type": "boolean" } }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "databaseHost"],
      "properties": {
        "registry": { "type": "string", "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.ap-northeast-[13]\\.amazonaws\\.com$" },
        "databaseHost": { "type": "string", "minLength": 1 },
        "accountId": { "type": "string", "pattern": "^([0-9]{12})?$" },
        "operatorRoleName": { "type": "string" },
        "serviceDomain": { "type": "string" },
        "valkeyHost": { "type": "string" },
        "filesKeyArn": { "type": "string" },
        "userPoolId": { "type": "string" },
        "cognitoLoginDomain": { "type": "string" },
        "sesConfigurationSet": { "type": "string" },
        "appClientId": { "type": "string" },
        "standbyUserPoolId": { "type": "string" },
        "standbyAppClientId": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "refreshInterval"],
      "properties": {
        "store": { "const": "application-secrets" },
        "refreshInterval": { "type": "string", "pattern": "^[0-9]+[smh]$" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "const": "sft/app" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "clamav": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "pattern": "^mirror/" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "network": {
      "type": "object",
      "required": ["vpcCidr", "publicSubnetsCidr", "endpointSubnetsCidr", "isolatedSubnetsCidr"],
      "properties": {
        "vpcCidr": { "type": "string", "pattern": "^10\\.[0-9]{1,3}\\.0\\.0/16$" },
        "publicSubnetsCidr": { "type": "string", "pattern": "^10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.0/[0-9]{2}$" },
        "endpointSubnetsCidr": { "type": "string", "pattern": "^10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.0/[0-9]{2}$" },
        "isolatedSubnetsCidr": { "type": "string", "pattern": "^10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.0/[0-9]{2}$" }
      }
    },
    "scanPools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["small", "large"],
      "properties": {
        "small": { "$ref": "#/definitions/replicas" },
        "large": { "$ref": "#/definitions/replicas" }
      }
    }
  },
  "definitions": {
    "replicas": {
      "type": "object",
      "required": ["replicas"],
      "properties": { "replicas": { "type": "integer", "minimum": 0 } }
    }
  }
}
