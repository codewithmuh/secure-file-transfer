        "y": 35
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Scan pass, p95 and p99",
      "description": "From a file's scan starting to its malware and inspection results recorded, by scan pool.",
      "datasource": {
        "type": "prometheus",
