{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "The observability root Application's values for one cluster",
  "type": "object",
  "required": ["environment", "region", "cluster", "pilotLight", "repoURL", "targetRevision", "applications"],
  "properties": {
    "environment": { "enum": ["dev", "staging", "prod"] },
    "region": { "enum": ["ap-northeast-1", "ap-northeast-3"] },
    "cluster": {
      "type": "object",
      "required": ["registry", "accountId"],
      "properties": {
        "registry": { "type": "string", "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.ap-northeast-[13]\\.amazonaws\\.com$" },
        "accountId": { "type": "string", "pattern": "^[0-9]{12}$" }
      }
    },
    "pilotLight": { "type": "boolean" },
    "repoURL": { "const": "https://github.com/codewithmuh/secure-file-transfer.git" },
    "targetRevision": { "const": "main" },
    "applications": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["namespace"],
        "properties": { "namespace": { "enum": ["monitoring", "grafana"] } }
      }
    }
  }
}
