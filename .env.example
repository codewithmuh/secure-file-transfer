# Copy to .env for local runs. Never commit .env; real secrets live in your cloud secret manager.
LOG_LEVEL=info

# Local stack (`make up`, docs/local-development.md). Every value below is local-only and fake, and works only against
# the stack on 127.0.0.1. These are for processes on the host; containers in the stack use the service names instead
# (postgres:5432, s3:9090, sqs:9324, valkey:6379, mail:1025, clamd:3310, oidc:8080). In AWS the values come from
# the environment's configuration and Secrets Manager.

# PostgreSQL 17, for Aurora (ADR-0011). AWS adds IAM authentication and sslmode=verify-full.
# The API logs in as its own workload role, never a superuser (ADR-0020); the pool refuses any other user. `make up`
# runs the bootstrap and migration jobs and gives every local login role this fake password (docs/local-development.md 3).
DATABASE_URL=postgresql+psycopg://sft_api:test-only-password@127.0.0.1:5432/sft
# The local server's superuser, for `make smoke` and `make test` only; never for a workload.
LOCAL_POSTGRES_URL=postgresql://sft:sft-local-only@127.0.0.1:5432/sft

# AWS SDK settings for the S3 and SQS stand-ins. The keys are fake, so a local run can never use a real AWS identity.
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=local-only
AWS_SECRET_ACCESS_KEY=local-only

# S3 (ADR-0012). The KMS key IDs are the bare IDs the stand-in accepts; in AWS they are the files and audit keys.
S3_ENDPOINT_URL=http://127.0.0.1:9090
S3_FILES_BUCKET=sft-local-files
S3_LARGE_FILES_BUCKET=sft-local-large-files
S3_AUDIT_BUCKET=sft-local-audit-archive
S3_FILES_KMS_KEY_ID=00000000-0000-4000-8000-000000000001
S3_AUDIT_KMS_KEY_ID=00000000-0000-4000-8000-000000000002

# SQS (ADR-0013). A queue's name is the prefix plus scan-small, scan-large, notify, signin-events, ses-events,
# guardduty-results or ses-tenant-status; each has a dead-letter queue with -dlq on the end.
SQS_ENDPOINT_URL=http://127.0.0.1:9324
SQS_QUEUE_PREFIX=sft-local-

# Valkey (ADR-0014). AWS uses rediss:// with the workload's IAM token as the password.
VALKEY_URL=redis://sft-local:local-only-valkey-password@127.0.0.1:6379/0

# Email (ADR-0015): SMTP into the mail catcher locally, the SES API v2 in AWS. Tests read what was sent from the
# catcher's API; people read it at http://localhost:8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=no-reply@mail.sft.localhost
MAIL_CATCHER_URL=http://127.0.0.1:8025

# Member sign-in (ADR-0016): Keycloak stands in for the Cognito user pool and its confidential app client.
OIDC_ISSUER=http://localhost:8180/realms/sft
OIDC_CLIENT_ID=sft-api-local
OIDC_CLIENT_SECRET=local-only-oidc-client-secret
OIDC_REDIRECT_URI=http://localhost:8000/v1/auth/callback

# clamd (ADR-0019)
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
