{
  "realm": "sft",
  "displayName": "secure-file-transfer, local only",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "passwordPolicy": "length(15) and maxLength(99)",
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant ID (custom:tenant_id)\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"enrolment_id\",\"displayName\":\"Enrolment the notification worker made the user for (#197)\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"idp_provider_name\",\"displayName\":\"SSO: the tenant provider that brokered the user (#231)\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"idp_user_id\",\"displayName\":\"SSO: the subject at the tenant provider (#231)\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"sso_groups\",\"displayName\":\"SSO: the tenant provider's groups (#231)\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":true}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "sft-api-local",
      "name": "API, local stand-in for the Cognito app client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-only-oidc-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": ["http://localhost:8000/v1/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["basic", "email"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "token_use in the ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "token_use",
            "claim.value": "id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        },
        {
          "name": "token_use in the access token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "token_use",
            "claim.value": "access",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "cognito:username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "cognito:username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        },
        {
          "name": "identities, the provider (Cognito's federated identity, #231)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "idp_provider_name",
            "claim.name": "identities.providerName",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        },
        {
          "name": "identities, the subject (Cognito's federated identity, #231)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "idp_user_id",
            "claim.name": "identities.userId",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        },
        {
          "name": "custom:sso_groups (#231)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "sso_groups",
            "claim.name": "custom:sso_groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        },
        {
          "name": "custom:tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "custom:tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "sft-notify-local",
      "name": "Notification worker, local stand-in for its Cognito admin permissions (authn-authz 2.5)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-only-notify-pool-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "identityProviders": [
    {
      "alias": "11111111111141118111111111111111",
      "displayName": "Local Example Co's identity provider (the customer realm), #231",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "issuer": "http://localhost:8180/realms/customer",
        "authorizationUrl": "http://localhost:8180/realms/customer/protocol/openid-connect/auth",
        "tokenUrl": "http://localhost:8080/realms/customer/protocol/openid-connect/token",
        "jwksUrl": "http://localhost:8080/realms/customer/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "sft-pool",
        "clientSecret": "local-only-customer-broker-secret",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid email",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "FORCE",
        "prompt": "login"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "username",
      "identityProviderAlias": "11111111111141118111111111111111",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": { "syncMode": "FORCE", "template": "${ALIAS}.${CLAIM.sub}", "target": "LOCAL" }
    },
    {
      "name": "subject",
      "identityProviderAlias": "11111111111141118111111111111111",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": { "syncMode": "FORCE", "claim": "sub", "user.attribute": "idp_user_id" }
    },
    {
      "name": "provider",
      "identityProviderAlias": "11111111111141118111111111111111",
      "identityProviderMapper": "hardcoded-attribute-idp-mapper",
      "config": { "syncMode": "FORCE", "attribute": "idp_provider_name", "attribute.value": "11111111111141118111111111111111" }
    },
    {
      "name": "groups",
      "identityProviderAlias": "11111111111141118111111111111111",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": { "syncMode": "FORCE", "claim": "groups", "user.attribute": "sso_groups" }
    }
  ],
  "users": [
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "22222222-2222-4222-8222-222222222222",
      "email": "dev.member@example.com",
      "emailVerified": true,
      "enabled": true,
      "attributes": {
        "tenant_id": ["11111111-1111-4111-8111-111111111111"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "local-only-member-password",
          "temporary": false
        }
      ]
    },
    {
      "id": "13131313-1313-4313-8313-131313131313",
      "username": "12121212-1212-4212-8212-121212121212",
      "email": "dev.approver@example.com",
      "emailVerified": true,
      "enabled": true,
      "attributes": {
        "tenant_id": ["11111111-1111-4111-8111-111111111111"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "local-only-approver-password",
          "temporary": false
        }
      ]
    },
    {
      "id": "55555555-5555-4555-8555-555555555555",
      "username": "44444444-4444-4444-8444-444444444444",
      "email": "dev.admin@example.com",
      "emailVerified": true,
      "enabled": true,
      "attributes": {
        "tenant_id": ["11111111-1111-4111-8111-111111111111"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "local-only-admin-password",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-sft-notify-local",
      "enabled": true,
      "serviceAccountClientId": "sft-notify-local",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users"]
      }
    }
  ]
}
